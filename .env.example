# RAWG API key (https://rawg.io/apidocs). Server-side only.
RAWG_API_KEY=
# Set to 1 to serve recorded fixtures instead of calling any upstream API (RAWG and Steam).
RAWG_FIXTURES=1
# Public site URL used for canonical and hreflang links.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Upstash Redis REST credentials for the price and localisation index. Server-side only.
# The site gets a READ-ONLY token and never writes: a page is answered with read commands alone.
# The write token belongs to the refresh job and lives only in GitHub Secrets.
# Without both values the site runs on the in-memory index seeded from the fixture.
# On Vercel these must be set with the NUXT_ prefix (NUXT_UPSTASH_REDIS_REST_URL,
# NUXT_UPSTASH_REDIS_REST_TOKEN) to override the values baked in at build time.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional, for the manual index smoke workflow: the site's read-only token, so a run can prove
# the read path works with the permissions the site actually has.
UPSTASH_REDIS_REST_READONLY_TOKEN=
