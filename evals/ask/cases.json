      "id": "uk-coop-switch-price",
      "q": "кооператив для двох на Switch до 500 грн",
      "locale": "uk",
      "topic": "platform + price + local co-op (the design's acceptance query)",
      "expect": {
        "mode": "structured",
        "must": {
          "platforms": [7],
          "gameModes": ["LOCAL_COOP"],
          "priceMaxUah": 500
        },
        "mustNot": ["free", "onSaleMinPercent", "ukrainianLocalisation", "search"]
      }
    },
