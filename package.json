{
  "name": "gg-stay",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "codegen": "graphql-codegen --config codegen.ts",
    "lint": "eslint .",
    "format": "git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --write --ignore-unknown",
    "format:check": "git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --check --ignore-unknown",
    "typecheck": "nuxt typecheck",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json && tsc --project tests/browser/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project nuxt",
    "e2e": "playwright test",
    "check:vercel-headers": "node scripts/check-vercel-headers.mjs",
    "check:bundle-budget": "tsx scripts/check-bundle-budget.ts",
    "smoke:index": "tsx scripts/index/smoke.ts",
    "index:refresh": "tsx scripts/index/run.ts",
    "eval:ask": "tsx scripts/eval/ask.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@upstash/redis": "^1.38.4",
    "@vercel/functions": "^3.9.9",
    "@vercel/speed-insights": "^2.0.0",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.0",
    "hls.js": "^1.7.3",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@lhci/cli": "^0.15.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
